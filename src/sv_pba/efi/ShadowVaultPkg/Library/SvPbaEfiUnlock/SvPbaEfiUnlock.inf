## @file
# ESP lab-vector unlock — links SvPbaFreestanding when SV_PBA_EFI_FREESTANDING=1.
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SvPbaEfiUnlock
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 0.1.0
  LIBRARY_CLASS                  = SvPbaEfiUnlock|UEFI_APPLICATION

[Sources]
  SvPbaEfiUnlock.c

[Packages]
  MdePkg/MdePkg.dec
  ShadowVaultPkg/ShadowVaultPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib
  UefiBootServicesTableLib
  UefiLib
  SvPbaFreestanding
  SvPbaHandoff

[Protocols]
  gEfiLoadedImageProtocolGuid

[Guids]
  gEfiFileInfoGuid

[BuildOptions]
  MSFT:*_*_X64_CC_FLAGS    = /I$(WORKSPACE)/ShadowVaultPkg/Include /W4 /D SV_PBA_EFI_FREESTANDING=1
  GCC:*_*_X64_CC_FLAGS     = -I$(WORKSPACE)/ShadowVaultPkg/Include -D SV_PBA_EFI_FREESTANDING=1