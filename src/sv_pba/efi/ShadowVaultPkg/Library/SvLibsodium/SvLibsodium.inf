## @file
# Vendored minimal libsodium for ShadowVault PBA unlock (UEFI / EDK2).
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SvLibsodium
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0.20
  LIBRARY_CLASS                  = SvLibsodium|UEFI_APPLICATION

[Sources]
  sodium_platform_uefi.c
  sodium_crt_uefi.c
  sodium_core_patch.c
  sodium_utils_minimal.c
  randombytes_uefi_api.c
  ../../../../../../external/libsodium_cmake/stubs.c
  ../../../../../../external/libsodium-src/src/libsodium/crypto_aead/xchacha20poly1305/aead_xchacha20poly1305.c
