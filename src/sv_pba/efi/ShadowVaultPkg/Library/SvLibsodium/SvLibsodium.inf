[Packages]
  MdePkg/MdePkg.dec
  ShadowVaultPkg/ShadowVaultPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib

[BuildOptions]
  MSFT:*_*_X64_CC_FLAGS    = /U_WIN32 /GL- /DCONFIGURED=1 /DSODIUM_STATIC=1 /DSODIUM_LIBRARY_MINIMAL=1 /DMINIMAL=1 /DNDEBUG /wd4319 /I$(WORKSPACE)/ShadowVaultPkg/Library/SvLibsodium/Include /I$(LIBSODIUM_INCLUDE) /I$(LIBSODIUM_INCLUDE)/sodium /W3
  GCC:*_*_X64_CC_FLAGS     = -U_WIN32 -DCONFIGURED=1 -DSODIUM_STATIC=1 -DSODIUM_LIBRARY_MINIMAL=1 -DMINIMAL=1 -DNDEBUG -I$(WORKSPACE)/ShadowVaultPkg/Library/SvLibsodium/Include -I$(LIBSODIUM_INCLUDE) -I$(LIBSODIUM_INCLUDE)/sodium -Wno-unused-parameter